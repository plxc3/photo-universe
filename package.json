  "description": "Memoria · 记忆的形状 — 把 3,000 张照片显影为可漫游的 3D 色温星环、螺旋走廊与全画幅光学液态暗房（Three.js + Custom GLSL）",
  "license": "MIT",
  "type": "module",
  "homepage": "https://plxc3.github.io/photo-universe/",
  "repository": {
    "type": "git",
    "url": "https://github.com/plxc3/photo-universe.git"
  },
  "keywords": [
    "threejs",
    "webgl",
    "glsl",
    "photo-gallery",
    "3d-gallery",
    "creative-coding",
    "interactive-art",
    "vite"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5178",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5178",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/*.test.js",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
